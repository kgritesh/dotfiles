[core]
	excludesfile = ~/.gitignore
	editor = zed --wait
	pager = delta

[alias]
    amend = commit -a --amend --no-edit
    co = checkout
    ci = commit
    st = status
    br = branch
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    add-ignore = !"g(){ url="https://raw.githubusercontent.com/github/gitignore/master/$1.gitignore" ; curl --output /dev/null --silent --head --fail "$url" ; if [ $? -eq 0 ]; then curl "$url" >> .gitignore && echo "Appended .gitignore with $url" ; else echo "$url doesnt exist." ; fi ; }; g"
	blame = blame -w -C -C -C
	fpush = push
	rebase-master = !git fetch origin master && git rebase origin/master
	rebase-main = !git fetch origin main && git rebase origin/main
	difft = !GIT_EXTERNAL_DIFF=difft git diff
	diffts = !GIT_EXTERNAL_DIFF=difft git diff --staged
	dlog = !GIT_EXTERNAL_DIFF=difft git log -p --ext-diff
[color]
	ui = auto

[push]
	default = current

# Use seperate file for private info (username, email, etc.)
[include]
  path = ~/.gitconfig.local
[diff]
	tool = meld
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
	dark = true
	file-style = bold yellow ul
	hunk-header-style = omit

[diff "difftastic"]
	command = difft
[branch]
	autoSetupMerge = always
[pull]
	ff = only
[init]
	defaultBranch = master
[user]
	name = Ritesh Kadmawala
	email = ritesh@vertexcover.io
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[submodule]
	recurse = true
[advice]
	detachedHead = false
[rerere]
	enabled = true
	autoUpdate = true
[maintenance]
	repo = /home/krg85/Projects/shopify-product-search
	repo = /home/krg85/Projects/Madmen/ad-insights-data-analysis
[column]
	ui = auto
[hub]
	protocol = https
