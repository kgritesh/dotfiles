[core]
	excludesfile = ~/.gitignore
	editor = zed --wait
	pager = delta

[alias]
    amend = commit -a --amend --no-edit
    co = checkout
    ci = commit
    st = status
    br = branch
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    add-ignore = !"g(){ url="https://raw.githubusercontent.com/github/gitignore/master/$1.gitignore" ; curl --output /dev/null --silent --head --fail "$url" ; if [ $? -eq 0 ]; then curl "$url" >> .gitignore && echo "Appended .gitignore with $url" ; else echo "$url doesnt exist." ; fi ; }; g"
	blame = blame -w -C -C -C
	fpush = push
	rebase-master = !git fetch origin master && git rebase origin/master
	rebase-main = !git fetch origin main && git rebase origin/main
	difft = !GIT_EXTERNAL_DIFF=difft git diff
	diffts = !GIT_EXTERNAL_DIFF=difft git diff --staged
	dlog = !GIT_EXTERNAL_DIFF=difft git log -p --ext-diff
	rebase-pick = "!f() {\n  # Usage: git rebase-pick <from-commit> [--base <base-ref>]\n  # Cherry-picks commits AFTER <from-commit> through HEAD onto <base-ref>.\n  # Default base: merge-base of HEAD with origin/main.\n\n  set -e\n\n  if [ -z \"$1\" ] || [ \"$1\" = \"--help\" ] || [ \"$1\" = \"-h\" ]; then\n    echo \"Usage: git rebase-pick <from-commit> [--base <base-ref>]\"\n    echo \"\"\n    echo \"Rebases current branch onto <base-ref> and cherry-picks commits\"\n    echo \"AFTER <from-commit> through HEAD.\"\n    echo \"\"\n    echo \"  <from-commit>  Commits after this ref are cherry-picked (exclusive).\"\n    echo \"                 Examples: HEAD~3, abc1234, HEAD^2\"\n    echo \"  --base <ref>   Target to rebase onto. Default: merge-base with origin/main.\"\n    echo \"\"\n    echo \"Example: git rebase-pick HEAD~3\"\n    echo \"  On branch: A - B - C - D - E (HEAD)\"\n    echo \"  Result:    base... - D' - E' (HEAD)\"\n    return 0\n  fi\n\n  FROM_COMMIT=\"$1\"\n  shift\n  BASE_REF=\"\"\n\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --base)\n        BASE_REF=\"$2\"\n        shift 2\n        ;;\n      *)\n        echo \"Unknown option: $1\" >&2\n        return 1\n        ;;\n    esac\n  done\n\n  # Resolve from-commit to actual SHA\n  FROM_SHA=$(git rev-parse \"$FROM_COMMIT\") || { echo \"Error: cannot resolve $FROM_COMMIT\" >&2; return 1; }\n\n  # Save current HEAD\n  HEAD_SHA=$(git rev-parse HEAD)\n\n  # Determine base\n  if [ -z \"$BASE_REF\" ]; then\n    # Default: merge-base with origin/main\n    git fetch origin main --quiet 2>/dev/null || true\n    BASE_REF=$(git merge-base HEAD origin/main) || { echo \"Error: cannot find merge-base with origin/main\" >&2; return 1; }\n  else\n    BASE_REF=$(git rev-parse \"$BASE_REF\") || { echo \"Error: cannot resolve --base $BASE_REF\" >&2; return 1; }\n  fi\n\n  # Collect commits to cherry-pick (from-commit exclusive .. HEAD)\n  COMMITS=$(git rev-list --reverse \"$FROM_SHA\"..\"$HEAD_SHA\")\n  if [ -z \"$COMMITS\" ]; then\n    echo \"No commits to cherry-pick between $FROM_COMMIT and HEAD.\"\n    return 0\n  fi\n\n  COUNT=$(echo \"$COMMITS\" | wc -l | tr -d \" \")\n  BRANCH=$(git rev-parse --abbrev-ref HEAD)\n\n  echo \"Branch:       $BRANCH\"\n  echo \"Base:         $(git rev-parse --short $BASE_REF)\"\n  echo \"Cherry-pick:  $COUNT commit(s) after $(git rev-parse --short $FROM_SHA)\"\n  echo \"Commits:\"\n  for c in $COMMITS; do\n    echo \"  $(git log --oneline -1 $c)\"\n  done\n  echo \"\"\n\n  # Reset branch to base\n  git reset --hard \"$BASE_REF\"\n\n  # Cherry-pick each commit\n  for c in $COMMITS; do\n    git cherry-pick \"$c\" || {\n      echo \"\"\n      echo \"Cherry-pick conflict on $(git rev-parse --short $c).\"\n      echo \"Resolve conflicts, then: git cherry-pick --continue\"\n      echo \"To abort: git cherry-pick --abort && git reset --hard $HEAD_SHA\"\n      return 1\n    }\n  done\n\n  echo \"\"\n  echo \"Done. $COUNT commit(s) cherry-picked onto $(git rev-parse --short $BASE_REF).\"\n  echo \"To undo: git reset --hard $HEAD_SHA\"\n}; f"
[color]
	ui = auto

[push]
	default = current

# Use seperate file for private info (username, email, etc.)
[include]
  path = ~/.gitconfig.local
[diff]
	tool = meld
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
	dark = true
	file-style = bold yellow ul
	hunk-header-style = omit

[diff "difftastic"]
	command = difft
[branch]
	autoSetupMerge = always
[pull]
	ff = only
[init]
	defaultBranch = master
[user]
	name = Ritesh Kadmawala
	email = ritesh@vertexcover.io
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[submodule]
	recurse = true
[advice]
	detachedHead = false
[rerere]
	enabled = true
	autoUpdate = true
[maintenance]
	repo = /home/krg85/Projects/shopify-product-search
	repo = /home/krg85/Projects/Madmen/ad-insights-data-analysis
[column]
	ui = auto
[hub]
	protocol = https
[merge]
	conflictStyle = zdiff3
